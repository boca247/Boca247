// noticias.js
// NOTICIAS ACTUALES DE BOCA JUNIORS

const FUENTES = [
  {
    nombre: "TyC Sports",
    url: "https://www.tycsports.com/boca-juniors.html"
  },
  {
    nombre: "Olé",
    url: "https://www.ole.com.ar/boca-juniors"
  },
  {
    nombre: "Boca Juniors",
    url: "https://www.bocajuniors.com.ar/noticias"
  },
  {
    nombre: "Planeta Boca Juniors",
    url: "https://planetabj.com/"
  },
  {
    nombre: "Bolavip",
    url: "https://bolavip.com/ar/resultados/futbol/equipo/boca/6861eac1-6a03-4954-aee7-6a2694fc86a2/noticias"
  }
];


// =====================================================
// CARGAR NOTICIAS
// =====================================================

async function cargarNoticias() {
  const contenedor = document.getElementById("noticias");

  if (!contenedor) {
    console.error("No existe el elemento #noticias");
    return;
  }

  contenedor.innerHTML = `
    <div class="cargando-noticias">
      <p>Buscando las últimas noticias de Boca...</p>
    </div>
  `;

  try {
    const noticias = await obtenerNoticias();

    if (!noticias || noticias.length === 0) {
      mostrarSinNoticias(contenedor);
      return;
    }

    mostrarNoticias(noticias, contenedor);

  } catch (error) {
    console.error("Error cargando noticias:", error);

    contenedor.innerHTML = `
      <div class="error-noticias">
        <h3>No se pudieron cargar las noticias</h3>
        <p>Reintentá en unos segundos.</p>
        <button onclick="cargarNoticias()">Reintentar</button>
      </div>
    `;
  }
}


// =====================================================
// OBTENER NOTICIAS ACTUALES
// =====================================================

async function obtenerNoticias() {

  const consultas = [
    "Boca Juniors últimas noticias",
    "Boca Juniors hoy",
    "Boca mercado de pases",
    "Boca lesiones",
    "Boca Sudamericana"
  ];

  let noticias = [];

  for (const consulta of consultas) {

    try {

      const url =
        "https://news.google.com/rss/search?q=" +
        encodeURIComponent(consulta + " when:1d") +
        "&hl=es-419&gl=AR&ceid=AR:es-419";

      const respuesta = await fetch(
        "https://api.allorigins.win/raw?url=" +
        encodeURIComponent(url),
        {
          cache: "no-store"
        }
      );

      if (!respuesta.ok) {
        continue;
      }

      const texto = await respuesta.text();

      const parser = new DOMParser();
      const xml = parser.parseFromString(texto, "text/xml");

      const items = xml.querySelectorAll("item");

      items.forEach(item => {

        const titulo =
          item.querySelector("title")?.textContent?.trim() || "";

        const link =
          item.querySelector("link")?.textContent?.trim() || "";

        const fecha =
          item.querySelector("pubDate")?.textContent?.trim() || "";

        const descripcion =
          item.querySelector("description")?.textContent?.trim() || "";

        if (!titulo || !link) {
          return;
        }

        const tituloLimpio = limpiarTexto(titulo);

        // Solo noticias realmente relacionadas con Boca
        if (!esDeBoca(tituloLimpio, descripcion)) {
          return;
        }

        noticias.push({
          titulo: tituloLimpio,
          fuente: obtenerFuente(item, tituloLimpio),
          contenido: limpiarDescripcion(descripcion),
          link: link,
          categoria: detectarCategoria(tituloLimpio),
          fecha_iso: fecha ? new Date(fecha).toISOString() : new Date().toISOString()
        });

      });

    } catch (error) {
      console.warn("No se pudo consultar:", consulta, error);
    }
  }

  // =====================================================
  // ELIMINAR DUPLICADAS
  // =====================================================

  const unicas = [];

  const vistos = new Set();

  for (const noticia of noticias) {

    const clave = normalizarTitulo(noticia.titulo);

    if (!vistos.has(clave)) {

      vistos.add(clave);
      unicas.push(noticia);

    }
  }

  // =====================================================
  // ORDENAR DE MÁS NUEVA A MÁS VIEJA
  // =====================================================

  unicas.sort((a, b) => {

    return new Date(b.fecha_iso) - new Date(a.fecha_iso);

  });

  // Máximo 30 noticias
  return unicas.slice(0, 30);
}


// =====================================================
// MOSTRAR NOTICIAS
// =====================================================

function mostrarNoticias(noticias, contenedor) {

  contenedor.innerHTML = "";

  noticias.forEach(noticia => {

    const tarjeta = document.createElement("article");

    tarjeta.className = "noticia";

    tarjeta.innerHTML = `

      <div class="noticia-categoria">
        ${escaparHTML(noticia.categoria)}
      </div>

      <h2>
        ${escaparHTML(noticia.titulo)}
      </h2>

      <div class="noticia-meta">

        <span>
          ${escaparHTML(noticia.fuente)}
        </span>

        <span>
          ${formatearFecha(noticia.fecha_iso)}
        </span>

      </div>

      <p>
        ${escaparHTML(noticia.contenido)}
      </p>

      <a
        href="${escaparAtributo(noticia.link)}"
        target="_blank"
        rel="noopener noreferrer"
        class="leer-noticia"
      >
        LEER NOTICIA
      </a>

    `;

    contenedor.appendChild(tarjeta);

  });
}


// =====================================================
// FUENTE
// =====================================================

function obtenerFuente(item, titulo) {

  const texto =
    titulo +
    " " +
    (item.querySelector("description")?.textContent || "");

  const textoLower = texto.toLowerCase();

  if (textoLower.includes("tyc sports")) {
    return "TyC Sports";
  }

  if (textoLower.includes("olé")) {
    return "Olé";
  }

  if (textoLower.includes("boca juniors")) {
    return "Boca Juniors";
  }

  if (textoLower.includes("planeta boca")) {
    return "Planeta Boca Juniors";
  }

  if (textoLower.includes("bolavip")) {
    return "Bolavip";
  }

  return "Noticias Boca";
}


// =====================================================
// CATEGORÍAS
// =====================================================

function detectarCategoria(titulo) {

  const t = titulo.toLowerCase();

  if (
    t.includes("mercado") ||
    t.includes("refuerzo") ||
    t.includes("fichaje") ||
    t.includes("oferta") ||
    t.includes("pase") ||
    t.includes("contrato")
  ) {
    return "Mercado de pases";
  }

  if (
    t.includes("lesión") ||
    t.includes("lesionado") ||
    t.includes("fractura") ||
    t.includes("operado") ||
    t.includes("parte médico")
  ) {
    return "Parte médico";
  }

  if (
    t.includes("sudamericana") ||
    t.includes("conmebol")
  ) {
    return "Sudamericana";
  }

  if (
    t.includes("bombonera") ||
    t.includes("lanús") ||
    t.includes("racing") ||
    t.includes("river") ||
    t.includes("partido") ||
    t.includes("triunfo") ||
    t.includes("victoria") ||
    t.includes("gol")
  ) {
    return "Primer equipo";
  }

  if (
    t.includes("juvenil") ||
    t.includes("reserva") ||
    t.includes("predio") ||
    t.includes("inferiores")
  ) {
    return "Boca Predio";
  }

  if (
    t.includes("femenino") ||
    t.includes("gladiadoras")
  ) {
    return "Fútbol femenino";
  }

  return "Boca";
}


// =====================================================
// COMPROBAR QUE SEA NOTICIA DE BOCA
// =====================================================

function esDeBoca(titulo, descripcion) {

  const texto = (
    titulo +
    " " +
    descripcion
  ).toLowerCase();

  const palabras = [
    "boca",
    "boca juniors",
    "xeneize",
    "bombonera",
    "riquelme",
    "paredes",
    "arruabarrena",
    "zenón",
    "aranda"
  ];

  return palabras.some(palabra =>
    texto.includes(palabra)
  );
}


// =====================================================
// LIMPIAR TÍTULO
// =====================================================

function limpiarTexto(texto) {

  return texto
    .replace(/<!\[CDATA\[|\]\]>/g, "")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .trim();

}


// =====================================================
// LIMPIAR DESCRIPCIÓN
// =====================================================

function limpiarDescripcion(texto) {

  const div = document.createElement("div");

  div.innerHTML = texto;

  const limpio = div.textContent || div.innerText || "";

  return limpiarTexto(limpio)
    .replace(/\s+/g, " ")
    .trim()
    .substring(0, 280);

}


// =====================================================
// NORMALIZAR TÍTULO
// =====================================================

function normalizarTitulo(titulo) {

  return titulo
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s]/g, "")
    .replace(/\s+/g, " ")
    .trim();

}


// =====================================================
// FECHA
// =====================================================

function formatearFecha(fecha) {

  const fechaNoticia = new Date(fecha);

  if (isNaN(fechaNoticia.getTime())) {
    return "Actualizado recientemente";
  }

  const ahora = new Date();

  const diferencia =
    ahora.getTime() -
    fechaNoticia.getTime();

  const minutos =
    Math.floor(diferencia / 60000);

  if (minutos < 1) {
    return "Hace unos segundos";
  }

  if (minutos < 60) {
    return `Hace ${minutos} min`;
  }

  const horas =
    Math.floor(minutos / 60);

  if (horas < 24) {
    return `Hace ${horas} h`;
  }

  return fechaNoticia.toLocaleDateString(
    "es-AR",
    {
      day: "2-digit",
      month: "2-digit",
      year: "numeric"
    }
  );
}


// =====================================================
// SEGURIDAD HTML
// =====================================================

function escaparHTML(texto) {

  const div =
    document.createElement("div");

  div.textContent = texto;

  return div.innerHTML;

}


function escaparAtributo(texto) {

  return String(texto)
    .replace(/&/g, "&amp;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

}


// =====================================================
// SIN NOTICIAS
// =====================================================

function mostrarSinNoticias(contenedor) {

  contenedor.innerHTML = `

    <div class="sin-noticias">

      <h3>No hay noticias nuevas</h3>

      <p>
        No encontramos publicaciones nuevas en las últimas 24 horas.
      </p>

      <button onclick="cargarNoticias()">
        ACTUALIZAR
      </button>

    </div>

  `;

}


// =====================================================
// ACTUALIZACIÓN AUTOMÁTICA
// =====================================================

// Actualiza al abrir la página
document.addEventListener(
  "DOMContentLoaded",
  () => {

    cargarNoticias();

    // Actualiza cada 10 minutos
    setInterval(
      cargarNoticias,
      10 * 60 * 1000
    );

  }
);
